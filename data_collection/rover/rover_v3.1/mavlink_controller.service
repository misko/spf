[Unit]
Description=Run mavlink controller
Requires=spf-pluto-direct-usb.service
# The collector talks to the FC over USB serial and the Plutos over USB; it
# needs no LAN/internet. Repository update is an earlier, separately bounded
# prerequisite. This unit can start as soon as the Pluto loader finishes.
After=spf-pluto-direct-usb.service

[Service]
WorkingDirectory=/home/pi/
User=pi
Group=pi
Environment=PYTHONPATH=/home/pi/spf/
EnvironmentFile=-/etc/spf/rover_collection.env
ExecStart=/home/pi/spf/data_collection/rover/rover_v3.1/drone_run.sh

[Install]
WantedBy=multi-user.target
