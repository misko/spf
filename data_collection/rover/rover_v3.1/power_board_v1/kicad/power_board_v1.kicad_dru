(version 1)

# Same-net copper overlaps are design intent on this board: the b2b FET
# common-drain lands (VSW/FE_MID/SW_A/SW_B) are merged pads of adjacent
# footprints, and micro-join stubs overlap their own nets' pads.
(rule "same-net overlap is by design"
  (condition "A.NetName == B.NetName")
  (constraint clearance (min 0mm)))

# J1 (XT60) mechanical mounting pegs are un-netted PTH pads that overhang
# the W board edge by design (mate direction W, audit I3).
(rule "unnetted mechanical pegs may touch edge"
  (condition "A.Type == 'Pad' && A.NetName == ''")
  (constraint edge_clearance (min 0mm)))

# J3 (USB-C) library footprint places its NPTH alignment pegs 0.1944mm from
# its own shield pads - intrinsic to the standard footprint, fabbed by JLC
# at scale. Scope the relaxation to pads inside J3 only.
(rule "usb-c footprint peg-to-shield geometry"
  (condition "A.memberOfFootprint('J3') && B.memberOfFootprint('J3')")
  (constraint hole_clearance (min 0.15mm)))

# Mechanical (un-netted) pads: FET footprints carry no-net paste/anchor pads
# that overlap their own drain lands; NPTH alignment pegs sit at footprint-
# intrinsic distances from their own shield pads (USB-C, fuse holder).
# Un-netted copper cannot short anything.
(rule "unnetted mechanical pads exempt from copper clearance"
  (condition "A.NetName == ''")
  (constraint clearance (min 0mm)))
(rule "npth pegs at footprint-intrinsic distances"
  (condition "A.Type == 'Pad' && A.NetName == ''")
  (constraint hole_clearance (min 0.1mm)))
