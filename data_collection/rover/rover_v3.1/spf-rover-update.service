[Unit]
Description=Update and reconcile SPF before rover hardware preparation
# Do not wait indefinitely for network-online.target. The updater performs its
# own bounded Git remote retry and permits an offline field boot.
After=local-fs.target network.target
Before=spf-pluto-direct-usb.service spf-direct-usb-preflight.service mavlink_controller.service

[Service]
Type=oneshot
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=GIT_TERMINAL_PROMPT=0
EnvironmentFile=-/etc/spf/rover_collection.env
WorkingDirectory=/home/pi/spf
ExecStart=/home/pi/spf/data_collection/rover/rover_v3.1/update_spf_before_boot.sh
TimeoutStartSec=15min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
