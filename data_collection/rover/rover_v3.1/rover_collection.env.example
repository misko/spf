# Installed as /etc/spf/rover_collection.env by configure_direct_usb_boot.sh.
#
# Firmware policy is independent of capture transport/schema. The conservative
# default keeps the historical IIO/v4 collector while the tested RAM image is
# loaded first. Select direct_usb_v4 to retain the v4 Zarr surface over direct
# USB, or direct_usb_v7 for full per-frame gain/RSSI endpoint metadata. To run
# the stock QSPI image as well, set SPF_DIRECT_USB_DISABLE=1 in
# /etc/spf/direct_usb_boot.env.
SPF_CAPTURE_PROFILE=legacy_iio_v4

# Preserve the historical production behavior unless an operator deliberately
# enables one of these bounded/safe test modes.
SPF_SKIP_SELF_UPDATE=0
SPF_SKIP_PARAMETER_SYNC=0
SPF_BOOT_VALIDATE_ONLY=0
SPF_RUN_ONCE=0

SPF_OUTPUT_ROOT=/home/pi/temp
SPF_RADIO_WAIT_SECONDS=600
SPF_PYTHON=/home/pi/spf-virtualenv/bin/python3
