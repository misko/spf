# Installed as /etc/spf/rover_collection.env by configure_direct_usb_boot.sh.
#
# Normal production resolves rover{1,2,3}_production_v7.yaml from
# /home/pi/rover_id. Set SPF_CAPTURE_CONFIG only for a deliberate, reviewed
# qualification override; both the firmware loader and collector consume it.
# SPF_CAPTURE_CONFIG=/absolute/path/to/qualified_capture.yaml

# Optional bounded/safe operating modes.
SPF_SKIP_SELF_UPDATE=0
# The early updater retries GitHub only within this boot-time budget. An
# unavailable remote never prevents an offline field boot from local code.
# SPF_UPDATE_REMOTE_WAIT_SECONDS=12
# SPF_UPDATE_GIT_TIMEOUT_SECONDS=4
SPF_SKIP_PARAMETER_SYNC=0
SPF_BOOT_VALIDATE_ONLY=0
SPF_RUN_ONCE=0

SPF_OUTPUT_ROOT=/home/pi/temp
SPF_RADIO_WAIT_SECONDS=600
SPF_PYTHON=/home/pi/spf-virtualenv/bin/python3
