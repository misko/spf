# Installed as /etc/spf/rover_collection.env by configure_direct_usb_boot.sh.
#
# direct_usb_v4 preserves the historical v4 Zarr fields. Change only this
# value to direct_usb_v7 when full per-frame gain/RSSI endpoint metadata is
# wanted. Use legacy_iio_v4 only after restoring stock firmware.
SPF_CAPTURE_PROFILE=direct_usb_v4

# Preserve the historical production behavior unless an operator deliberately
# enables one of these bounded/safe test modes.
SPF_SKIP_SELF_UPDATE=0
SPF_SKIP_PARAMETER_SYNC=0
SPF_BOOT_VALIDATE_ONLY=0
SPF_RUN_ONCE=0

SPF_OUTPUT_ROOT=/home/pi/temp
SPF_RADIO_WAIT_SECONDS=600
SPF_PYTHON=/home/pi/spf-virtualenv/bin/python3
