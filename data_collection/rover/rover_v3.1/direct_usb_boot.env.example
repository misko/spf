# Install as /etc/spf/direct_usb_boot.env.
#
# The canonical capture YAML selects the firmware boot mode. Production V7
# currently uses persistent QSPI and flashes only an active-version mismatch.
# SPF_DIRECT_USB_DISABLE=1 is an explicit legacy/manual recovery opt-out; it
# does not replace firmware already stored in QSPI.
SPF_DIRECT_USB_DISABLE=0
SPF_DIRECT_USB_RECORDS=100
SPF_DIRECT_USB_OUTPUT_ROOT=/home/pi/preflight/boot_direct_usb
SPF_FIRMWARE_CACHE_DIR=/home/pi/.cache/spf/firmware
SPF_FIRMWARE_STATE_DIR=/var/lib/spf/pluto-firmware
SPF_APPROVED_QSPI_DEVICE_FW=v0.37-dirty
SPF_PYTHON=/home/pi/spf-virtualenv/bin/python3

# Fewer radios than the canonical Rover config triggers a repeating alarm,
# then a clean shutdown. An operator may cancel during the grace period with:
#   sudo touch /run/spf/cancel_radio_missing_shutdown
SPF_RADIO_MISSING_GRACE_SECONDS=45
SPF_RADIO_MISSING_ACTION=poweroff
