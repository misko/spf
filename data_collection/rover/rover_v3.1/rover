#!/usr/bin/env bash
#
# rover — one front door to the Rover 3.1 fleet tooling.
#
# Installed on a rover as /usr/local/bin/rover, a SYMLINK into the git working
# tree. That is deliberate: a copied CLI would go stale exactly the way the
# checkout did when `./run_motor_test.py` came back "No such file or directory"
# on rover 1 while sitting ten commits behind main. Because the symlink points
# into the tree, `git pull` updates the CLI along with everything else.
#
#   rover doctor              one-screen health check
#   rover ardupilot <sub>      prearm, compass, rc, motor-test, flash
#   rover radio <sub>          status, firmware, preflight, capture
#   rover sitl <sub>           status, up, down  (base station only)
#   rover audit | config | version | install
#
# Settings come from the environment, then an optional
# ~/.rover_config, then built-in defaults. The file is normally absent --
# it exists mainly so tests can inject known values. `rover config` shows
# the effective value of each setting and where it came from.
#
# The groups dispatch to the existing scripts unchanged -- this is a front
# door, not a rewrite, so every script stays directly callable and rovers
# 1/2/3 boot from main exactly as before.
#
# This dispatcher is bash, not Python, so that `rover doctor` still runs on a
# half-provisioned rover whose virtualenv is missing or broken. Diagnosing that
# is the job; a Python CLI could not start to do it.

set -euo pipefail

# Resolve through the /usr/local/bin symlink to the real file in the tree, so
# the repo root is discovered rather than hardcoded. This also lets the CLI and
# its tests run from a dev-box checkout that is not /home/pi/spf.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROVER_DIR="$(dirname "$SELF")"

# ---------------------------------------------------------------- config ---
#
# ~/.rover_config holds per-machine settings: SITL ports on the base station,
# a non-default checkout, and so on. It is PARSED, never sourced. Sourcing
# would execute arbitrary shell as whoever ran the CLI -- including root, via
# `sudo rover install` -- and could not implement the precedence below.
#
#   real environment  >  ~/.rover_config  >  built-in default
#
# so `SPF_SITL_HOST=x rover sitl status` still wins over the file, and tests
# can point SPF_ROVER_CONFIG at a fixture.
ROVER_CONFIG="${SPF_ROVER_CONFIG:-${HOME:-/root}/.rover_config}"

declare -A ROVER_CONFIG_ENV=()

load_rover_config() {
    # Snapshot which settings the real environment supplied, so `rover config`
    # can report provenance after both sources land in the same variables.
    local exported
    for exported in $(compgen -v SPF_ 2>/dev/null || true); do
        [[ -n "${!exported:-}" ]] && ROVER_CONFIG_ENV["$exported"]=1
    done
    [[ -r "$ROVER_CONFIG" ]] || return 0
    local key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"                      # strip comments
        [[ "$line" == *=* ]] || continue        # skip blanks and junk
        key="${line%%=*}"; value="${line#*=}"
        key="${key//[[:space:]]/}"
        # Only SPF_-prefixed shell-safe names, so a stray line cannot clobber
        # PATH, HOME, or any of the CLI's own internals.
        [[ "$key" =~ ^SPF_[A-Z0-9_]+$ ]] || continue
        value="${value#"${value%%[![:space:]]*}"}"   # trim leading space
        value="${value%"${value##*[![:space:]]}"}"   # trim trailing space
        value="${value%\"}"; value="${value#\"}"     # strip surrounding quotes
        value="${value%\'}"; value="${value#\'}"
        [[ -n "${!key:-}" ]] && continue        # a real env var wins
        printf -v "$key" '%s' "$value"
    done <"$ROVER_CONFIG"
}
load_rover_config

REPO_ROOT="${SPF_REPO_ROOT:-$(cd "${ROVER_DIR}/../../.." && pwd)}"
VENV="${SPF_VENV:-/home/pi/spf-virtualenv}"
INSTALL_PATH="${SPF_ROVER_CLI_PATH:-/usr/local/bin/rover}"
READY_MANIFEST="${SPF_DIRECT_USB_READY_FILE:-/run/spf/direct_usb_ready.json}"
# ADALM-PLUTO / PlutoPlus USB id, as reported by lsusb on rovers 1 and 2.
PLUTO_USB_ID="${SPF_PLUTO_USB_ID:-0456:b673}"
# The sim runs on the base station, never on a rover (ROVER_RUNBOOK §6).
SITL_HOST="${SPF_SITL_HOST:-192.168.1.141}"
SITL_IMAGE="${SPF_SITL_IMAGE:-csmisko/ardupilotspf:latest}"
# Overridable so a test can point the check at a port it controls.
SITL_PORTS="${SPF_SITL_PORTS:-14590 14591 14592}"

# Every operator-facing subcommand, in help order. tests/test_rover_cli.py
# reads this list and asserts each entry both dispatches and answers --help,
# so a subcommand cannot be documented without working, or work unlisted.
SUBCOMMANDS=(doctor ardupilot radio sitl audit config env version install help)

# ~/.rover_config configures THIS CLI. The capture services never read it --
# systemd hands them /etc/spf/rover_collection.env via EnvironmentFile=, and
# drone_run.sh sources that same file. Keeping the two apart matters: a
# SPF_CRASH_* key in ~/.rover_config would be reported as the effective value
# while the rover ignored it, which is the exact question `rover config` exists
# to answer correctly.
PROFILE_ENV="${SPF_PROFILE_ENV:-/etc/spf/rover_collection.env}"
# shellcheck source=data_collection/rover/rover_v3.1/rover_env_defaults.sh
source "${ROVER_DIR}/rover_env_defaults.sh"

die() { printf '\nERROR: %s\n' "$*" >&2; exit 1; }
note() { printf '  %s\n' "$*"; }
head_() { printf '\n== %s ==\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; }

usage() {
    cat <<EOF
rover — Rover 3.1 fleet tooling

usage: rover <command> [options]

commands:
  doctor      one-screen health check: git state, services, hardware, disk
  ardupilot   flight controller: prearm, compass, motor-test, flash  (alias: ap)
  radio       Plutos: status, firmware, preflight, capture
  sitl        simulator on the base station: status, up, down
  audit       read-only fleet fingerprint (identity.* vs fleet.* drift)
  config      effective settings, and where each value came from
  env         capture-service settings: crash_detect, crash_recovery
  version     what this checkout is, and whether it matches main
  install     symlink this CLI to ${INSTALL_PATH} (needs sudo)
  help        this message

  Run 'rover <command> --help' for detail.

environment:
  SPF_REPO_ROOT   checkout to operate on  (default: derived from this script)
  SPF_VENV        virtualenv              (default: /home/pi/spf-virtualenv)

notes:
  Provisioning a new rover is still provision_rover.sh; this CLI is the
  day-to-day front door, not a replacement for it.
EOF
    exit "${1:-0}"
}

# ---------------------------------------------------------------- identity ---

# Rover id comes from the hostname (roverpiN, set by configure_rover_network.sh)
# so that no subcommand has to be told which rover it is running on. Getting
# this wrong is worse than not knowing it, so an unrecognised hostname yields
# empty rather than a guess.
rover_id() {
    local host
    host="$(hostname 2>/dev/null || true)"
    [[ "$host" =~ ^roverpi([0-9]+)$ ]] && printf '%s' "${BASH_REMATCH[1]}"
}

require_rover_id() {
    local id
    id="$(rover_id)"
    [[ -n "$id" ]] || die "not a rover: hostname '$(hostname 2>/dev/null)' is not roverpiN.
  This command must run on a rover. Provision one with provision_rover.sh."
    printf '%s' "$id"
}

# ------------------------------------------------------------- git / stale ---

# Bounded and non-fatal by design. A rover in the field may have no route to
# GitHub, and a CLI that hangs or refuses to run because it cannot reach the
# network is useless exactly when it is needed most.
git_remote_state() {
    local behind
    if ! timeout 5 git -C "$REPO_ROOT" fetch --quiet origin main 2>/dev/null; then
        printf 'offline'
        return
    fi
    behind="$(git -C "$REPO_ROOT" rev-list --count HEAD..origin/main 2>/dev/null || echo '?')"
    if [[ "$behind" == "0" ]]; then printf 'current'; else printf 'behind:%s' "$behind"; fi
}

report_git() {
    local head state untracked
    head="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    note "checkout : ${REPO_ROOT}"
    note "HEAD     : ${head}"

    # Mirror update_spf_before_boot.sh's gate EXACTLY: it runs `git diff
    # --quiet` and `git diff --cached --quiet` and refuses on either. It does
    # not look at untracked files. Counting `status --porcelain` instead would
    # warn on every rover in the fleet -- all of them carry untracked operational
    # files (pluto_env, this_rover.params, device_mapping) -- and a warning that
    # is always on is a warning nobody reads.
    local blocked=0
    if ! git -C "$REPO_ROOT" diff --quiet -- 2>/dev/null; then
        bad "tracked files modified — boot update will refuse: git -C ${REPO_ROOT} diff --stat"
        blocked=1
    fi
    if ! git -C "$REPO_ROOT" diff --cached --quiet -- 2>/dev/null; then
        bad "staged changes present — boot update will refuse: git -C ${REPO_ROOT} diff --cached --stat"
        blocked=1
    fi
    if [[ "$blocked" -eq 0 ]]; then
        untracked="$(git -C "$REPO_ROOT" ls-files --others --exclude-standard 2>/dev/null | wc -l)"
        # Informational only: these do not block a fast-forward.
        ok "no update-blocking changes ($((untracked)) untracked file(s), which do not block)"
    fi

    state="$(git_remote_state)"
    case "$state" in
        current) ok "up to date with origin/main" ;;
        offline) warn "cannot reach origin — staleness unknown (no network?)" ;;
        behind:*) bad "BEHIND origin/main by ${state#behind:} commit(s) — run: git -C ${REPO_ROOT} pull --ff-only" ;;
    esac
}

# ------------------------------------------------------------------ doctor ---

report_services() {
    local unit state
    for unit in spf-rover-update spf-pluto-direct-usb mavlink_controller; do
        state="$(systemctl is-active "$unit" 2>/dev/null || true)"
        case "$state" in
            active)   ok "${unit}: active" ;;
            inactive) note "${unit}: inactive" ;;
            failed)   bad "${unit}: FAILED — journalctl -u ${unit} -n50" ;;
            *)        note "${unit}: ${state:-not installed}" ;;
        esac
    done
    # What the next capture will actually do when the rover jams. Cheap to
    # print, and it is the first thing you want after a rover comes home stuck.
    local key
    for key in "${SPF_CAPTURE_ENV_KEYS[@]}"; do
        note "${key,,}: $(capture_env_label "$(capture_env_effective "$key")")"
    done
}

report_hardware() {
    local fc plutos
    # by-id, never /dev/ttyACM*: on rover 2 ttyACM0 is the PlutoSDR and ttyACM1
    # is the flight controller, so the glob picks the wrong device.
    fc="$(ls /dev/serial/by-id/usb-ArduPilot* 2>/dev/null | head -1 || true)"
    if [[ -n "$fc" ]]; then ok "flight controller: $(basename "$fc")"; else bad "flight controller: not found"; fi

    # Count by USB vendor:product. Plutos enumerate as USB *ethernet gadgets*
    # -- eth1 and eth2 on rover 1 -- not as usbN, so matching interface names
    # reports zero radios on a rover that has two attached.
    plutos="$(lsusb -d "$PLUTO_USB_ID" 2>/dev/null | wc -l)"
    if [[ "${plutos:-0}" -gt 0 ]]; then ok "plutos attached: ${plutos}"; else bad "plutos attached: none"; fi

    # Attached is not the same as usable. The ready manifest is what the boot
    # chain actually gates on, and it goes stale on a git pull -- which is how
    # rover 2 ended up refusing to capture after an update earlier today.
    if [[ -r "$READY_MANIFEST" ]]; then
        local attached configured manifest_sha head_sha
        attached="$(grep -o '"attached_radio_count"[: ]*[0-9]*' "$READY_MANIFEST" | grep -o '[0-9]*$')"
        configured="$(grep -o '"configured_receiver_count"[: ]*[0-9]*' "$READY_MANIFEST" | grep -o '[0-9]*$')"
        if [[ "${attached:-0}" == "${configured:-x}" ]]; then
            ok "ready manifest: ${attached}/${configured} radios"
        else
            bad "ready manifest: ${attached:-?} attached vs ${configured:-?} configured"
        fi

        # The manifest pins the commit it was generated from. A `git pull`
        # moves HEAD and strands it, and the capture then refuses to start with
        # "spf_git_sha is stale or mismatched" -- which is what happened to
        # rover 2 after an update this morning. Radio counts still look right
        # when this is wrong, so it has to be checked separately.
        manifest_sha="$(grep -o '"spf_git_sha"[: ]*"[a-f0-9]*"' "$READY_MANIFEST" | grep -o '[a-f0-9]\{7,\}')"
        head_sha="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)"
        if [[ -z "$manifest_sha" ]]; then
            warn "ready manifest has no spf_git_sha"
        elif [[ "$manifest_sha" == "$head_sha" ]]; then
            ok "manifest matches HEAD"
        else
            bad "manifest is STALE (built at ${manifest_sha:0:7}, HEAD is ${head_sha:0:7})
      the next capture will refuse to start — regenerate with:
      sudo systemctl restart spf-pluto-direct-usb"
        fi
    else
        warn "no ready manifest at ${READY_MANIFEST} — radios not prepared this boot"
    fi

    if [[ -x "${VENV}/bin/python3" ]]; then ok "virtualenv: ${VENV}"; else bad "virtualenv missing: ${VENV}"; fi
}

report_disk() {
    local pct avail
    pct="$(df --output=pcent / 2>/dev/null | tail -1 | tr -dc '0-9' || echo 0)"
    avail="$(df -h --output=avail / 2>/dev/null | tail -1 | tr -d ' ' || echo '?')"
    if [[ "${pct:-0}" -ge 90 ]]; then
        bad "root filesystem ${pct}% full (${avail} free) — captures will fail"
    elif [[ "${pct:-0}" -ge 75 ]]; then
        warn "root filesystem ${pct}% full (${avail} free)"
    else
        ok "root filesystem ${pct}% full (${avail} free)"
    fi
}

cmd_doctor() {
    [[ "${1:-}" =~ ^(-h|--help)$ ]] && { echo "usage: rover doctor
One-screen health check. Read-only; changes nothing. Non-zero exit if
anything is broken enough to stop a mission."; return 0; }

    local id; id="$(rover_id)"
    head_ "rover ${id:-?} — $(hostname 2>/dev/null)"
    head_ "git";      report_git
    head_ "services"; report_services
    head_ "hardware"; report_hardware
    head_ "disk";     report_disk
    printf '\n'
}

cmd_audit() {
    [[ "${1:-}" =~ ^(-h|--help)$ ]] && { echo "usage: rover audit
Read-only fleet fingerprint via audit_rover.sh. Splits identity.* fields
(expected to differ per rover) from fleet.* fields (drift)."; return 0; }
    local id; id="$(require_rover_id)"
    exec bash "${ROVER_DIR}/audit_rover.sh" "$id" "$@"
}

cmd_version() {
    [[ "${1:-}" =~ ^(-h|--help)$ ]] && { echo "usage: rover version
Print the checkout's commit, and whether it matches origin/main."; return 0; }
    head_ "rover CLI"
    note "repo   : ${REPO_ROOT}"
    note "rover  : $(rover_id || echo 'not a rover')"
    report_git
    printf '\n'
}

# ------------------------------------------------------------------ config ---

cmd_config() {
    [[ "${1:-}" =~ ^(-h|--help)$ ]] && { echo "usage: rover config
Show every setting, its effective value, and where that value came from
(environment, ${ROVER_CONFIG}, or built-in default).

The config file is optional. Absent -- the normal case on a rover and on the
base station -- every setting falls back to its built-in default."; return 0; }

    head_ "config"
    if [[ -r "$ROVER_CONFIG" ]]; then
        note "file : ${ROVER_CONFIG}"
    else
        note "file : ${ROVER_CONFIG} (absent — using built-in defaults)"
    fi
    printf '\n  %-26s %-34s %s\n' SETTING VALUE SOURCE
    local name value
    for name in SPF_REPO_ROOT:"$REPO_ROOT" SPF_VENV:"$VENV" \
                SPF_ROVER_CLI_PATH:"$INSTALL_PATH" \
                SPF_DIRECT_USB_READY_FILE:"$READY_MANIFEST" \
                SPF_PLUTO_USB_ID:"$PLUTO_USB_ID" SPF_SITL_HOST:"$SITL_HOST" \
                SPF_SITL_IMAGE:"$SITL_IMAGE" SPF_SITL_PORTS:"$SITL_PORTS"; do
        value="${name#*:}"; name="${name%%:*}"
        printf '  %-26s %-34s %s\n' "$name" "$value" "$(config_source "$name")"
    done
    printf '\n'

    # Capture-service settings are a separate table on purpose: they resolve
    # from a different file, for a different consumer. Folding them into the
    # table above would let ~/.rover_config appear as the source of a value the
    # rover never sees.
    head_ "capture services"
    note "file : ${PROFILE_ENV}"
    note "read by systemd units and drone_run.sh, never from ${ROVER_CONFIG}"
    report_capture_env
}

# ------------------------------------------------------------------- env ---
#
# Capture-service settings. These live in PROFILE_ENV rather than
# ~/.rover_config because that is the only file that reaches a running capture.

# Value as written in the profile file, or empty if unset there.
capture_env_file_value() {
    local key="$1"
    [[ -r "$PROFILE_ENV" ]] || return 0
    sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$PROFILE_ENV" |
        tail -n 1 | tr -d '"'\''[:space:]'
}

# Effective value: the file wins if it sets the key, otherwise the built-in
# per-rover default. Deliberately NOT influenced by ~/.rover_config -- see the
# note by PROFILE_ENV.
capture_env_effective() {
    local key="$1" id value
    id="$(rover_id || true)"
    value="$(capture_env_file_value "$key")"
    if [[ -n "$value" ]]; then printf '%s' "$value"; return; fi
    spf_capture_env_default "$key" "$id"
}

capture_env_label() {
    spf_env_is_true "$1" && printf 'enabled' || printf 'disabled'
}

# Warn when a capture setting was put somewhere it cannot take effect. Cheap,
# and it closes the one footgun the two-file split creates.
capture_env_shadow_warning() {
    local key subcommand
    [[ -r "$ROVER_CONFIG" ]] || return 0
    for key in "${SPF_CAPTURE_ENV_KEYS[@]}"; do
        if grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$ROVER_CONFIG"; then
            subcommand="${key#SPF_}"
            warn "${key} is set in ${ROVER_CONFIG}, which capture never reads."
            note "Set it with: sudo rover env ${subcommand,,} enable|disable"
        fi
    done
    return 0
}

report_capture_env() {
    local key id value source_label
    id="$(rover_id || true)"
    printf '\n  %-22s %-10s %s\n' SETTING VALUE SOURCE
    for key in "${SPF_CAPTURE_ENV_KEYS[@]}"; do
        value="$(capture_env_file_value "$key")"
        if [[ -n "$value" ]]; then
            source_label="$PROFILE_ENV"
        else
            value="$(spf_capture_env_default "$key" "$id")"
            source_label="default ($(spf_capture_env_default_note "$key" "$id"))"
        fi
        printf '  %-22s %-10s %s\n' \
            "$key" "$(capture_env_label "$value")" "$source_label"
    done
    if [[ ! -r "$PROFILE_ENV" ]]; then
        printf '\n'; note "${PROFILE_ENV} (absent — using built-in defaults)"
    fi
    capture_env_shadow_warning
    if systemctl is-active --quiet mavlink_controller 2>/dev/null; then
        ok "mavlink_controller.service active — changes apply at next capture start"
    fi
    printf '\n'
}

# The requirement is being able to write the file, not being root -- on a rover
# /etc/spf is root-owned so this still demands sudo, but it stays honest (and
# testable) when PROFILE_ENV is pointed somewhere else.
capture_env_require_writable() {
    local action="$1" verb="$2" dir
    dir="$(dirname "$PROFILE_ENV")"
    [[ -d "$dir" ]] || mkdir -p "$dir" 2>/dev/null || true
    if [[ -e "$PROFILE_ENV" ]]; then
        [[ -w "$PROFILE_ENV" ]] && return 0
    elif [[ -d "$dir" && -w "$dir" ]]; then
        return 0
    fi
    die "cannot write ${PROFILE_ENV}: sudo rover env ${action} ${verb}"
}

# Idempotent and atomic: rewrite the key in place if present, append it if not,
# and never disturb another setting in the file.
capture_env_write() {
    local key="$1" value="$2" tmp
    tmp="$(mktemp "${PROFILE_ENV}.XXXXXX")" || die "cannot write near ${PROFILE_ENV}"
    if [[ -r "$PROFILE_ENV" ]]; then
        grep -vE "^[[:space:]]*${key}[[:space:]]*=" "$PROFILE_ENV" >"$tmp" || true
    fi
    printf '%s=%s\n' "$key" "$value" >>"$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$PROFILE_ENV" || { rm -f "$tmp"; die "failed to update ${PROFILE_ENV}"; }
}

cmd_env() {
    local action="${1:-}"; shift || true
    local key
    case "$action" in
        crash_detect|crash-detect)     key=SPF_CRASH_DETECT ;;
        crash_recovery|crash-recovery) key=SPF_CRASH_RECOVERY ;;
        ""|-h|--help)
            group_usage env \
                "Settings the capture services read from ${PROFILE_ENV}." \
                "This is NOT ~/.rover_config, which configures only this CLI." \
                "" \
                "subcommands:" \
                "  crash_detect     detect a stalled rover and hand it to the operator" \
                "  crash_recovery   first try to reverse out of the jam (rover 4 only)" \
                "" \
                "  rover env <setting>                   show the effective value" \
                "  sudo rover env <setting> enable       turn it on for this rover" \
                "  sudo rover env <setting> disable      turn it off for this rover"
            return 0 ;;
        *) die "unknown env subcommand: ${action} (try: rover env --help)" ;;
    esac

    local verb="${1:-}"
    case "$verb" in
        -h|--help)
            # group_usage promises this works for every subcommand.
            printf 'usage: rover env %s [enable|disable]\n\n' "$action"
            printf '%s\n' \
                "With no action, print the effective value and where it came from." \
                "enable/disable write ${key} to ${PROFILE_ENV}, which is the" \
                "only file the capture services read. Takes effect at the next" \
                "capture start: sudo systemctl restart mavlink_controller"
            return 0 ;;
        "")
            head_ "${action//-/_}"
            local id value
            id="$(rover_id || true)"
            value="$(capture_env_file_value "$key")"
            if [[ -n "$value" ]]; then
                note "setting  : $(capture_env_label "$value")     (${key}=${value} in ${PROFILE_ENV})"
            else
                note "setting  : unset"
                note "default  : $(capture_env_label "$(spf_capture_env_default "$key" "$id")")     ($(spf_capture_env_default_note "$key" "$id"))"
            fi
            note "effective: $(capture_env_label "$(capture_env_effective "$key")")"
            capture_env_shadow_warning
            if systemctl is-active --quiet mavlink_controller 2>/dev/null; then
                ok "mavlink_controller.service active — applies at next capture start"
            fi
            printf '\n' ;;
        enable|disable)
            capture_env_require_writable "$action" "$verb"
            [[ "$verb" == "enable" ]] && capture_env_write "$key" 1 ||
                capture_env_write "$key" 0
            ok "${key}=$([[ "$verb" == enable ]] && echo 1 || echo 0) in ${PROFILE_ENV}"
            note "restart to apply: sudo systemctl restart mavlink_controller" ;;
        *) die "unknown action: ${verb} (expected: enable, disable, or nothing to read)" ;;
    esac
}

# Reports where a setting came from. The environment and the file are both
# read into the same variable, so this re-reads the file to tell them apart.
config_source() {
    local key="$1"
    if [[ -n "${ROVER_CONFIG_ENV[$key]:-}" ]]; then printf 'environment'; return; fi
    if [[ -r "$ROVER_CONFIG" ]] && grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$ROVER_CONFIG"; then
        printf '%s' "$ROVER_CONFIG"; return
    fi
    printf 'default'
}

# ----------------------------------------------------------------- install ---

cmd_install() {
    [[ "${1:-}" =~ ^(-h|--help)$ ]] && { echo "usage: sudo rover install
Symlink this CLI to ${INSTALL_PATH} so 'rover' works from any directory,
including over ssh. A symlink, not a copy, so git pull updates it."; return 0; }

    [[ $EUID -eq 0 ]] || die "must run as root: sudo ${SELF} install"

    local target_dir; target_dir="$(dirname "$INSTALL_PATH")"
    [[ -d "$target_dir" ]] || die "no such directory: ${target_dir}"

    if [[ -e "$INSTALL_PATH" && ! -L "$INSTALL_PATH" ]]; then
        die "${INSTALL_PATH} exists and is not a symlink — refusing to overwrite"
    fi

    ln -sfn "$SELF" "$INSTALL_PATH"
    ok "${INSTALL_PATH} -> ${SELF}"

    # /usr/local/bin is first on pi's non-interactive ssh PATH, but verify
    # rather than assume: /sbin is absent from that PATH, which has already
    # caused one script to report an installed binary as missing.
    if command -v rover >/dev/null 2>&1; then
        ok "'rover' resolves to $(command -v rover)"
    else
        warn "'rover' is not on PATH (${PATH}) — invoke ${INSTALL_PATH} directly"
    fi
    printf '\n'
}

# ------------------------------------------------------------------- venv ---

# Resolve the interpreter rather than advising about it. Every wrapped Python
# script currently fails with its own "use the SPF virtualenv" message, which
# tells the operator what went wrong but still makes them fix it by hand.
venv_python() {
    local interpreter="${VENV}/bin/python3"
    [[ -x "$interpreter" ]] ||
        die "virtualenv python missing: ${interpreter}
  Rebuild it with: sudo ./provision_rover.sh \$(rover version) --stage base"
    printf '%s' "$interpreter"
}

group_usage() {
    local group="$1"; shift
    printf 'usage: rover %s <subcommand> [options]\n\n' "$group"
    printf '%s\n' "$@"
    printf "\nRun 'rover %s <subcommand> --help' for that subcommand's own options.\n" "$group"
}

# -------------------------------------------------------------- ardupilot ---

cmd_ardupilot() {
    local action="${1:-}"; shift || true
    case "$action" in
        prearm)
            exec bash "${ROVER_DIR}/check_ardupilot_prearm.sh" "$@" ;;
        compass)
            exec bash "${ROVER_DIR}/check_compass_policy.sh" "$@" ;;
        motor-test)
            require_rover_id >/dev/null
            exec "$(venv_python)" "${ROVER_DIR}/run_motor_test.py" "$@" ;;
        flash)
            exec bash "${ROVER_DIR}/flash_ardupilot.sh" "$@" ;;
        rc)
            # Read-only listener. ardu_cli refuses a direct serial link while
            # mavlink_controller.service owns it, so no guard is needed here.
            exec "$(venv_python)" "${REPO_ROOT}/spf/ardupilot/ardu_cli.py" rc "$@" ;;
        ""|-h|--help)
            group_usage ardupilot \
                "subcommands:" \
                "  prearm       report pre-arm health and every failing check" \
                "  compass      verify the compass policy (which slots are used for yaw)" \
                "  rc           echo what the FC hears from the radio — bind/switch debugging" \
                "  motor-test   spin the motors at a throttle ladder — WHEELS MUST BE RAISED" \
                "  flash        flash ArduPilot firmware to the flight controller"
            ;;
        *) die "unknown ardupilot subcommand: ${action} (try: rover ardupilot --help)" ;;
    esac
}

# ------------------------------------------------------------------ radio ---

cmd_radio() {
    local action="${1:-}"; shift || true
    case "$action" in
        firmware)
            # Mounts each Pluto's updater volume, so it genuinely needs root.
            [[ $EUID -eq 0 ]] || die "'rover radio firmware' must run as root: sudo rover radio firmware"
            exec bash "${ROVER_DIR}/check_pluto_firmware.sh" "$@" ;;
        preflight)
            require_rover_id >/dev/null
            exec bash "${ROVER_DIR}/run_direct_usb_boot_preflight.sh" "$@" ;;
        capture)
            require_rover_id >/dev/null
            exec bash "${ROVER_DIR}/drone_run.sh" "$@" ;;
        status)
            head_ "radios"; report_hardware; printf '\n' ;;
        ""|-h|--help)
            group_usage radio \
                "subcommands:" \
                "  status       attached Plutos and ready-manifest state (read-only)" \
                "  firmware     running firmware per radio, by USB serial (needs sudo)" \
                "  preflight    one motion-free production-shaped capture after boot" \
                "  capture      the production boot launcher (drone_run.sh)"
            ;;
        *) die "unknown radio subcommand: ${action} (try: rover radio --help)" ;;
    esac
}

# ------------------------------------------------------------------- sitl ---

cmd_sitl() {
    local action="${1:-}"; shift || true

    # The sim runs on the base station, never on a rover: no arm64 image is
    # built, and the rover dials out to .141 instead. Refusing here is cheaper
    # than a confusing docker pull failure on a Pi.
    if [[ -n "$(rover_id)" && "$action" != "" && "$action" != "-h" && "$action" != "--help" ]]; then
        die "SITL runs on the base station (${SITL_HOST}), never on a rover.
  This is roverpi$(rover_id). The rover dials out to the sim; see ROVER_RUNBOOK §6."
    fi

    case "$action" in
        status)
            head_ "sitl"
            note "host  : ${SITL_HOST}"
            note "image : ${SITL_IMAGE}"
            local containers
            containers="$(docker ps --filter "ancestor=${SITL_IMAGE}" --format '{{.ID}} {{.Status}}' 2>/dev/null || true)"
            if [[ -n "$containers" ]]; then ok "sim running: ${containers}"; else note "no sim container running"; fi
            # CI shares this box and binds 14590/14591 on every push, so a
            # collision is the normal failure, not an exotic one.
            local busy=0 port
            for port in $SITL_PORTS; do
                if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
                    bad "port ${port} is already bound — CI or another sim owns it"
                    busy=1
                fi
            done
            [[ "$busy" -eq 0 ]] && ok "ports ${SITL_PORTS// /, } are free"
            printf '\n' ;;
        up)
            command -v docker >/dev/null || die "docker is not installed on this host"
            local spawn="${SPF_SITL_SPAWN:-37.76509485,-122.40940127,0,0}"
            printf '\n  launching sim (Ctrl-C to stop); wait for "Detected vehicle"\n\n'
            exec docker run --rm -it -p 14590-14595:14590-14595 "$SITL_IMAGE" \
                /ardupilot/Tools/autotest/sim_vehicle.py \
                -l "$spawn" -v rover -f rover-skid \
                --out tcpin:0.0.0.0:14590 --out tcpin:0.0.0.0:14591 -S 1 "$@" ;;
        down)
            local ids
            ids="$(docker ps -q --filter "ancestor=${SITL_IMAGE}" 2>/dev/null || true)"
            [[ -n "$ids" ]] || { note "no sim container running"; return 0; }
            docker stop $ids >/dev/null && ok "stopped: ${ids}" ;;
        ""|-h|--help)
            group_usage sitl \
                "Runs on the base station (${SITL_HOST}), never on a rover." \
                "" \
                "subcommands:" \
                "  status   is a sim running, and are 14590/14591 free of CI?" \
                "  up       launch the sim (foreground; Ctrl-C to stop)" \
                "  down     stop any running sim container" \
                "" \
                "env: SPF_SITL_SPAWN=lat,lon,alt,heading  (default: SF / Crissy Field)"
            ;;
        *) die "unknown sitl subcommand: ${action} (try: rover sitl --help)" ;;
    esac
}

# ---------------------------------------------------------------- dispatch ---

main() {
    [[ $# -gt 0 ]] || usage 0
    local command="$1"; shift
    case "$command" in
        doctor)          cmd_doctor "$@" ;;
        ardupilot|ap)    cmd_ardupilot "$@" ;;
        radio)           cmd_radio "$@" ;;
        sitl)            cmd_sitl "$@" ;;
        audit)           cmd_audit "$@" ;;
        config)          cmd_config "$@" ;;
        env)             cmd_env "$@" ;;
        version)         cmd_version "$@" ;;
        install)         cmd_install "$@" ;;
        help|-h|--help)  usage 0 ;;
        --subcommands)   printf '%s\n' "${SUBCOMMANDS[@]}" ;;  # for tests
        *)
            printf '\nERROR: unknown command: %s\n' "$command" >&2
            usage 2
            ;;
    esac
}

main "$@"
